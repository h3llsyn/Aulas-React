# ARQUIVO DE EXEMPLO PARA VARIÁVEIS DE AMBIENTE
# Copie este arquivo para ".env" e preencha com seus dados.

# URL base da sua API real (quando tiver uma). 
# No Vite, as variáveis que vão para o frontend precisam começar com "VITE_"
VITE_API_URL=https://api-rest-pe67.onrender.com

# Qualquer chave ou token público que seu site precise usar
VITE_PUBLIC_API_KEY=sua_chave_generica_aqui
